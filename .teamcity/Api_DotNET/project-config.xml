<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" parent-id="Api" uuid="" xsi:noNamespaceSchemaLocation="https://www.jetbrains.com/teamcity/schemas/2025.3/project-config.xsd">
  <name>dotNET</name>
  <parameters>
    <param name="env.CMAKE_BUILD_TYPE" value="Release" />
    <param name="env.DOTNET_HOME" value="%dotnet_home%" spec="text display='normal' readOnly='true' label='Location of the `dotnet` executable' validationMode='any'" />
    <param name="env.NUGET_ENABLE_LEGACY_CSPROJ_PACK" value="true" />
    <param name="qdb.nuget.package.suffix" value="-Suffix nightly.%build.counter%" />
  </parameters>
  <project-extensions>
    <extension id="PROJECT_EXT_1" type="versionedSettings">
      <parameters>
        <param name="buildSettings" value="PREFER_CURRENT" />
        <param name="credentialsStorageType" value="credentialsJSON" />
        <param name="enabled" value="true" />
        <param name="ignoreChangesInDependenciesAndVcsSettings" value="false" />
        <param name="rootId" value="Api_DotNET_VcsSettings" />
        <param name="showChanges" value="true" />
      </parameters>
    </extension>
  </project-extensions>
</project>

